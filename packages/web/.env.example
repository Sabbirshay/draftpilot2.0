# Public origin must match the browser address exactly.
APP_URL=http://127.0.0.1:3000
# Used only by the Next.js server. No NEXT_PUBLIC provider credentials.
API_INTERNAL_URL=http://127.0.0.1:3001
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Set to 1 only for an explicitly isolated demonstration deployment.
DRAFTPILOT_DEMO=0
# Build-time public API origin for the downloadable Chrome extension.
DRAFTPILOT_API_URL=http://127.0.0.1:3001
