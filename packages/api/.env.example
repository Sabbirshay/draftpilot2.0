NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_URL=http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:3001
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Comma-separated, at most two supported models; confirm availability in your account.
OPENROUTER_MODELS=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STRIPE_SECRET_KEY=
STRIPE_TEAM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Explicit Chrome extension origins after loading/publishing the extension.
EXTENSION_ORIGINS=
# At least 32 random bytes. Used only by the scheduled retention job.
RETENTION_JOB_SECRET=

# Emergency stop, applied to every API instance after restart/redeploy.
GENERATION_PAUSED=0

# API server only; generate with: openssl rand -base64 32
# Back up separately from the database. Never expose via NEXT_PUBLIC_*.
AI_KEY_ENCRYPTION_KEY=
# Atomic global UTC-day ceiling, including embeddings and admin probes.
# Attempts are not refunded on provider errors. Also set provider spending limits.
AI_DAILY_CALL_LIMIT=1000
